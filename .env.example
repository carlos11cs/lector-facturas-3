OPENAI_API_KEY=
DATABASE_URL=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
# Required only for the persistent invoice queue. This bucket must be private.
PRIVATE_STORAGE_BUCKET=
ANALYSIS_TIMEOUT_SECONDS=600
GUNICORN_TIMEOUT_SECONDS=660
MAX_UPLOAD_SIZE_MB=12
ACCOUNTING_IMPORT_MAX_ROWS=5000
# Disabled by default. Requires a separate Render worker and a private S3-compatible bucket.
ASYNC_INVOICE_ANALYSIS_ENABLED=false
ASYNC_INVOICE_ANALYSIS_LEASE_SECONDS=720
ASYNC_INVOICE_ANALYSIS_RESULT_TTL_SECONDS=86400
ASYNC_INVOICE_ANALYSIS_POLL_SECONDS=1.5
PDF_TEXT_THRESHOLD=50
PDF_OCR_ZOOM=2.0
OPENAI_CHAT_MODEL=gpt-4o-mini
# Modelo multimodal dedicado a facturas. Debe admitir entrada de imágenes.
OPENAI_INVOICE_MODEL=gpt-5.6-sol
OPENAI_INVOICE_MAX_OUTPUT_TOKENS=32768
OPENAI_INVOICE_TIMEOUT_SECONDS=240
OPENAI_INVOICE_REASONING_EFFORT=low
OPENAI_INVOICE_AUDIT_REASONING_EFFORT=high
OPENAI_INVOICE_VISION_MAX_PAGES=2
OPENAI_INVOICE_VISION_MAX_DIMENSION=1400
ACCESS_FROM_EMAIL=
REPORTS_FROM_EMAIL=
APP_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ADVANCED=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ADVANCED_ANNUAL=
